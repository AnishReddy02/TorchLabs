[Unit]
Description=Bench Node remote hardware executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/bench/node.env
ExecStart=/usr/local/bin/bench-node
Restart=always
RestartSec=3
User=bench
Group=bench
StateDirectory=bench
WorkingDirectory=/var/lib/bench
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bench
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
